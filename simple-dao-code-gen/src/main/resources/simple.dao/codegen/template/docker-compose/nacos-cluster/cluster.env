# default environment arguments for docker-compose-nacos.yml

NACOS_VERSION="v2.5.1"

# spring
SPRING_DATASOURCE_PLATFORM=mysql

# mysql
MYSQL_SERVICE_DB_NAME=nacos
MYSQL_SERVICE_HOST=nacos.db.com
MYSQL_SERVICE_PORT=13306
MYSQL_SERVICE_USER=nacos
MYSQL_SERVICE_PASSWORD=nacos123456
MYSQL_SERVICE_DB_PARAM="characterEncoding=utf8&connectTimeout=1000&socketTimeout=3000&autoReconnect=true&useUnicode=true&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true"

#JVM
JVM_XMS=384m #default :2g
JVM_XMX=384m #default :2g
JVM_XMN=128m #default :1g

PREFER_HOST_MODE=hostname  # 使用主机名模式

####################################################

# 运行模式
MODE=cluster
MODE=standalone

#集群模式要指定 nacos集群地址
NACOS_SERVERS=nacos1.com:18848 nacos2.com:28848 nacos3.com:38848
