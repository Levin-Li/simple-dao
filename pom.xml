    <modelVersion>4.0.0</modelVersion>

    <groupId>com.levin.commons</groupId>
    <artifactId>simple-dao-parent</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <properties>

        <revision>4.2.0-SNAPSHOT</revision>

        <spring-boot.version>4.0.5</spring-boot.version>
        <spring-cloud.version>2025.1.1</spring-cloud.version>

        <jitpack.groupId>com.github.Levin-Li</jitpack.groupId>

        <levin.service-support.groupId>${jitpack.groupId}</levin.service-support.groupId>

        <levin.service-support.groupId>com.levin.commons</levin.service-support.groupId>

        <levin.service-support.version>2.0.0-SNAPSHOT</levin.service-support.version>

        <maven.version>3.9.9</maven.version>
        <maven-plugin-plugin.version>3.15.2</maven-plugin-plugin.version>
        <maven-compiler-plugin.version>3.14.1</maven-compiler-plugin.version>
        <lombok.version>1.18.44</lombok.version>

        <maven.compiler.source>25</maven.compiler.source>

        <maven.compiler.release>17</maven.compiler.release>
        <maven.compiler.target>17</maven.compiler.target>

        <maven.test.skip>false</maven.test.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <maven.source.skip>false</maven.source.skip>

        <maven-source-plugin.attach>true</maven-source-plugin.attach>
        <maven-jar-plugin.addMavenDescriptor>false</maven-jar-plugin.addMavenDescriptor>

        <!-- <hibernate.version>5.4.27.Final</hibernate.version> -->

        <io.swagger.core.v3.version>2.2.41</io.swagger.core.v3.version>

        <springdoc.version>3.0.2</springdoc.version>

        <fastjson.version>2.0.60</fastjson.version>


        <fastjson2.version>2.0.60</fastjson2.version>
        <querydsl.version>5.1.0</querydsl.version>

        <dubbo.version>3.3.5</dubbo.version>
        <groovy.version>5.0.4</groovy.version>

        <hibernateTypes.version>3.15.2</hibernateTypes.version>

        <com.alibaba.druid.version>1.2.23</com.alibaba.druid.version>
        <commons-io.version>2.21.0</commons-io.version>

        <com.dameng.driver.version>8.1.3.140</com.dameng.driver.version>
        <com.oracle.driver.version>23.9.0.25.07</com.oracle.driver.version>
        <hutool.version>5.8.43</hutool.version>
    </properties>

    <modules>
        <module>simple-dao-annotations</module>
        <module>simple-dao-core</module>
        <module>simple-dao-jpa</module>
        <module>simple-dao-id-generator</module>
        <module>simple-dao-jpa-starter</module>
        <module>simple-dao-examples</module>
        <module>simple-dao-code-gen</module>
        <module>simple-dao-code-gen-example</module>
    </modules>

    <profiles>

        <profile>
            <id>01-跳过测试</id>

            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>

            <properties>
                <maven.test.skip>true</maven.test.skip>
            </properties>
        </profile>


        <profile>
            <id>02-上传源代码到 Maven</id>
            <properties>
                <maven.source.skip>false</maven.source.skip>
            </properties>
        </profile>


        <profile>
            <id>03-上传JavaDoc到 Maven</id>
            <properties>
                <maven.javadoc.skip>false</maven.javadoc.skip>
            </properties>
        </profile>

        <profile>
            <id>olny-for-without-gitpack-env</id>
            <activation>
                <file>
                    <!--  关键字：jitpack 表示是在 gitpack 打包-->
                    <missing>/home/jitpack/build/pom.xml</missing>
                    <!--  <missing>/home/jitpack/build/${project.artifactId}/pom.xml</missing> -->
                </file>
            </activation>

            <repositories>

                <repository>
                    <!-- 仓库首页 https://maven.aliyun.com/ , 如果在 gitpack.io 打包时会非常的慢 -->
                    <id>aliyun-central仓和jcenter仓的聚合仓</id>
                    <url>https://maven.aliyun.com/repository/public</url>
                </repository>

            </repositories>

            <pluginRepositories>

                <pluginRepository>
                    <!-- 仓库首页 https://maven.aliyun.com/ , 如果在 gitpack.io 打包时会非常的慢 -->
                    <id>aliyun-central仓和jcenter仓的聚合仓</id>
                    <url>https://maven.aliyun.com/repository/public</url>
                </pluginRepository>

            </pluginRepositories>

        </profile>

    </profiles>


    <repositories>

        <repository>
            <id>jitpack.io</id>
            <url>https://www.jitpack.io</url>
        </repository>

    </repositories>

    <pluginRepositories>

        <pluginRepository>
            <!--  插件库 -->
            <id>jitpack.io</id>
            <url>https://www.jitpack.io</url>
        </pluginRepository>

    </pluginRepositories>

    <distributionManagement>
        <!--具体变量来自 Setting 文件-->
        <repository>
            <id>${dist-repo}</id>
            <url>${dist-repo.releases.url}</url>
        </repository>

        <snapshotRepository>
            <id>${dist-repo}</id>
            <url>${dist-repo.snapshots.url}</url>
        </snapshotRepository>

    </distributionManagement>


    <dependencyManagement>
        <dependencies>

            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

